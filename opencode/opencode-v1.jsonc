{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "ai4eosc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI4EOSC LLM",
      "options": {
        "baseURL": "https://vllm.cloud.ai4eosc.eu/",
        "apiKey": "{env:AI4EOSC_LLM_KEY}"
      },
      "models": {
        "AI4EOSC/default": { },
        "AI4EOSC/Qwen/Qwen3-14B": { }
      }
    }
  },
  // permission control, check: https://opencode.ai/docs/permissions/
  // if commented out, the default permission is used
//   "permission": {
//     "skill": {
//       "*": "ask",
//       "read": "allow",
//       "pr-review": "allow",
//       "internal-*": "deny",
//       "experimental-*": "ask"
//     }
//   }
}
