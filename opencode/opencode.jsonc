{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  // Plugin for pruning context
  //"plugins": ["@tarquinen/opencode-dcp@latest"],

  // Custom AI4EOSC search provider plugin (SearXNG backend behind the vLLM
  // gateway). The __DEEP_START_DIR__ placeholder is replaced by deep-start.sh
  // with the actual script directory at config install time. The plugin is
  // authenticated with AI4EOSC_LLM_KEY and registers the provider only when
  // that key is set; otherwise websearch falls back to the built-in (keyless)
  // providers. Endpoint can be overridden with AI4EOSC_SEARCH_URL.
  "plugins": [
    { "package": "__DEEP_START_DIR__/opencode/plugins/ai4eosc-search" }
  ],

  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": 8000,
  },

  "websearch": {
    "provider": "random",
  },

  // Websearch works keyless out-of-the-box (no search provider API key needed;
  // OpenCode sends an access-mode "keyless" header to the search provider).
  // Pre-authorize it so headless "opencode serve" deployments don't block on
  // the interactive first-search permission prompt.
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],

  // Default first model
  "model": "ai4eosc/AI4EOSC/default-agentic",

  "providers": {
    "ai4eosc": {
      "package": "@ai-sdk/openai-compatible",
      "name": "AI4EOSC",
      "settings": {
        "baseURL": "https://vllm.cloud.ai4eosc.eu/",
        "apiKey": "{env:AI4EOSC_LLM_KEY}"
      },
      "models": {
        "AI4EOSC/default-agentic": {
          "name": "AI4EOSC (default-agentic)",
          "limit": {
            "context": 29999,
            "output": 4096
          }
        },
        "AI4EOSC/default-embeddings": {
          "name": "AI4EOSC (default-embeddings)",
          "limit": {
            "context": 29999,
            "output": 4096
          }
        }
      }
    },

    // Helmholtz Blablador service, https://blablador.fz-juelich.de/
    "blablador": {
      "package": "@ai-sdk/openai-compatible",
      "name": "Blablador",
      "settings": {
        "baseURL": "https://api.blablador.fz-juelich.de/v1",
        "apiKey": "{env:BLABLADOR_API_KEY}"
      },

      "models": {
        "alias-code": {
          "name": "Blablador Code (alias-code)",
          "limit": {
            "context": 98304,
            "output": 32768
          }
        },
        "alias-huge": {
          "name": "Blablador Minimax (alias-huge)",
          "limit": {
            "context": 98304,
            "output": 32768
          }
        },
        "alias-fast": {
          "name": "Blablador Fast (alias-fast)",
           "limit": {
            "context": 98304,
            "output": 32768
          }
        },
        "alias-large": {
          "name": "Blablador Large (alias-large)",
           "limit": {
            "context": 98304,
            "output": 32768
          }
        }
      }
    }
  }

// permission control, check: https://opencode.ai/v2/docs/permissions/
}
